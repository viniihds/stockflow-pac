# ---- Banco de dados ----
# Local (docker/postgres): valores abaixo.
# Producao (Neon): preencha com os dados da conexao do Neon e use POSTGRES_SSLMODE=require.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stockflow
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=stockflow
POSTGRES_SSLMODE=prefer

# ---- Servidor ----
# Porta do servidor Spring Boot (no Render a porta vem da variavel PORT, nao precisa definir)
SERVER_PORT=8080

# ---- Seguranca ----
# Segredo do JWT em Base64 (minimo 32 bytes). OBRIGATORIO em producao.
# Gere um com:  openssl rand -base64 48
# JWT_SECRET=
JWT_EXP_MINUTES=60

# Origens do frontend permitidas (CORS), separadas por virgula, SEM "/" no final.
# Em producao, coloque a URL da Vercel, por exemplo: https://stockflow-pac.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
